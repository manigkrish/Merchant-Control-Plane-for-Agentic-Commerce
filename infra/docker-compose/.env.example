# Local development only (copy to .env and adjust as needed)
# IMPORTANT: Do not commit .env (it should remain gitignored).

# -----------------------------------------------------------------------------
# Postgres (used by token-service; also available for future services)
# For docker-compose network, the hostname is typically "postgres".
# If you run services directly on host (mvn spring-boot:run), use localhost.
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agenttrust
POSTGRES_PASSWORD=agenttrust
POSTGRES_DB=agenttrust

# -----------------------------------------------------------------------------
# Redis (used by attestation-service replay + decision-service idempotency)
# For docker-compose network, the hostname is typically "redis".
# If you run services directly on host, use localhost.
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Internal service base URLs (gateway/decision-service clients)
# In docker-compose network, use service DNS names.
# -----------------------------------------------------------------------------
ATTESTATION_BASE_URL=http://attestation-service:8082
DECISION_BASE_URL=http://decision-service:8083
TOKEN_BASE_URL=http://token-service:8084

# -----------------------------------------------------------------------------
# MinIO (local S3-compatible storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=agenttrust
MINIO_ROOT_PASSWORD=agenttrust123
